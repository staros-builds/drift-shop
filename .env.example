# Drift backend selection.
# local    -> localStorage-backed adapter, honestly labeled "local device mode" in the UI
# supabase -> Supabase adapter (degrades to local with a note when the vars below are absent)
# replit   -> stub adapter (TODO: wire Replit Postgres REST API)
VITE_DRIFT_BACKEND=local

# Required only when VITE_DRIFT_BACKEND=supabase
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
